# MySQL Configuration
# NOTE: Host port is set to 3307 to prevent conflicts with your local MySQL running on port 3306.
MYSQL_PORT=3307
MYSQL_DATABASE=finance_tracker
MYSQL_USER=finance_user
MYSQL_PASSWORD=finance_secret
MYSQL_ROOT_PASSWORD=finance_root_secret

# FastAPI Backend Configuration
API_PORT=8000
DATABASE_URL=mysql+pymysql://finance_user:finance_secret@localhost:3307/finance_tracker
