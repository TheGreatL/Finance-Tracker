{
    "name": "finance-tracker-monorepo",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "test": "turbo run test",
        "typecheck": "turbo run typecheck",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "postinstall": "node scripts/patch-expo-notifications.js",
        "mobile": "npm run start --workspace=@finance-tracker/mobile",
        "mobile:android": "npm run android --workspace=@finance-tracker/mobile",
        "mobile:build": "npm run build:apk --workspace=@finance-tracker/mobile",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.14.0",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "turbo": "^2.4.4",
        "typescript-eslint": "^8.72.1"
    },
    "packageManager": "npm@11.19.0"
}
